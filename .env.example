# Trading 212 API credentials (Settings -> API in the app)
T212_API_KEY=
T212_API_SECRET=

# demo = practice account, live = real money
T212_ENV=demo
# true = log orders without sending them
DRY_RUN=true
# Required (=yes) only for T212_ENV=live with DRY_RUN=false
I_UNDERSTAND_THIS_TRADES_REAL_MONEY=no

# T212 ticker:Yahoo symbol, comma separated
SYMBOLS=AAPL_US_EQ:AAPL,MSFT_US_EQ:MSFT,NVDA_US_EQ:NVDA
